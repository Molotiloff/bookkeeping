# CRM API is called by the Next.js server over the local interface.
CRM_USE_API=true
CRM_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public URLs used by the browser and Telegram OIDC.
CRM_WS_URL=wss://skyex.work.gd/ws
CRM_FRONTEND_ORIGIN=https://skyex.work.gd
TELEGRAM_OIDC_CLIENT_ID=8453451926

# Never enable the bypass on a production deployment.
CRM_DEV_AUTH_BYPASS=false
